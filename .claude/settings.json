{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/load-docs.sh",
            "timeout": 30,
            "statusMessage": "Loading the living docs"
          }
        ]
      }
    ]
  }
}
