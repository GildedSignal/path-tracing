+#[test]
+fn delayed_server_snapshots_are_not_compared() {
+    let state = PlayerState::default();
+    for offset in ["1", "9", "null"] {
+        let snapshot = format!("{{\"serverTickOffset\":{offset},\"health\":-1}}");
+        assert!(!check_server_snapshot(&state, &Object::parse(&snapshot)));
+    }
+    assert!(!check_server_snapshot(&state, &Object::parse("{\"health\":-1}")));
+    let snapshot = "{\"serverTickOffset\":0,\"health\":20,\"foodLevel\":20,\"saturationLevel\":5,\"exhaustion\":0,\"foodTickTimer\":0}";
+    assert!(check_server_snapshot(&state, &Object::parse(snapshot)));
+    let bad = snapshot.replace("\"foodTickTimer\":0", "\"foodTickTimer\":7");
+    assert!(std::panic::catch_unwind(|| check_server_snapshot(&state, &Object::parse(&bad))).is_err());
+    let bad = snapshot.replace("\"health\":20", "\"health\":19");
+    assert!(std::panic::catch_unwind(|| check_server_snapshot(&state, &Object::parse(&bad))).is_err());
+}
