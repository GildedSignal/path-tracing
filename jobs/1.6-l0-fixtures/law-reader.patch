+#[test]
+fn recorder_end_trailer() {
+    let (world, mut state) = stationary_fixture();
+    let recording = format!("{}\n{{\"type\":\"end\",\"ticks\":1,\"complete\":true}}", stationary_recording());
+    assert_eq!(replay_text(&recording, &world, &mut state).0, 1);
+    for bad in [recording.replace("\"complete\":true", "\"complete\":false"),
+        recording.replace("\"ticks\":1", "\"ticks\":2"), format!("{recording}\n{}", stationary_recording())] {
+        let (world, mut state) = stationary_fixture();
+        assert!(std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| replay_text(&bad, &world, &mut state))).is_err());
+    }
+}
